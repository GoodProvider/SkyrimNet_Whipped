{# Whip wounds: what each wounded body part looks like. Data: skyrimnet_whipped_welts(uuid) from SkyrimNet_Whipped.dll  #}
{# (DamageHealing_Engine); empty once every hit part has fully healed. part.text = region * 6 + stage index:       #}
{#   region 0 head, 1 body, 2 arm, 3 leg; stage 0 light, 1 medium, 2 severe, 3 recovering, 4 mostly healed, 5 healed #}
{% set whip = skyrimnet_whipped_welts(actorUUID) %}
{% if existsIn(whip, "parts") and length(whip.parts) > 0 %}
{% if render_mode == "full" or render_mode == "thoughts" or render_mode == "thought" or render_mode == "transform" or render_mode == "dialogue_target" %}
{% set whip_name = decnpc(actorUUID).name %}
{% if lower(decnpc(actorUUID).sex) == "male" %}{% set whip_him = "him" %}{% set whip_his = "his" %}{% else %}{% set whip_him = "her" %}{% set whip_his = "her" %}{% endif %}
{% set whip_looks = [
  "@N@'s face: a bright red diagonal welt crosses @his@ cheek or forehead, raised and swollen; the skin is unbroken.",
  "@N@'s face: a deep red-to-purple welt with thin splits of broken skin beaded with dark blood; swelling is starting to close one of @his@ eyes.",
  "@N@'s face: gaping lacerations with raw strands across the wound; dark blood pours down @his@ jaw and neck; one eye is swollen shut and the rest of @his@ face is deathly pale.",
  "@N@'s face: thick, crusted maroon-black scabs line the cuts; the skin around them is mottled yellow-green; hair is missing in patches along the scalp lines.",
  "@N@'s face: the scabs are gone, leaving shiny pink-purple scar tissue edged with darkened skin.",
  "@N@'s face: a thin silvery-white scar line remains; on the scalp or brow it leaves a narrow bald track.",
  "@N@'s back: long, raised pink-red stripes cross @his@ shoulder blades and ribs; no open wounds.",
  "@N@'s back: parallel tramline bruises, dark red-purple raised borders around paler strips, with small cuts and pinpoint bleeding.",
  "@N@'s back and torso: ragged, deep lacerations cut through the skin into the flesh beneath; huge purple-black bruises spread across @him@; dark blood soaks @his@ clothing.",
  "@N@'s back: broad, raised blackish-red scab ridges, surrounded by bruising fading from purple to green and yellow.",
  "@N@'s back: raised purplish-pink scar lines framed by brownish darkened skin.",
  "@N@'s back: permanent tramline scars, darker brown or faded pale, are stamped across it.",
  "@N@'s @P@: a diagonal red welt across the forearm or upper arm with slight swelling.",
  "@N@'s @P@: a wide purple bruise with pinpoint bleeding under the skin and scraped lines; the arm looks visibly thickened.",
  "@N@'s @P@: gaping lacerations expose raw tissue; dark blood drips down the wrist and fingers; the hand is puffy and swollen.",
  "@N@'s @P@: a long, thick maroon scab across the arm surrounded by fading yellow-green bruising; the elbow or wrist is held bent.",
  "@N@'s @P@: a bright pink, slightly raised scar along the strike line, bordered by faint brown.",
  "@N@'s @P@: a faint, smooth, pale scar line runs along the arm.",
  "@N@'s @P@: a straight red welt across the thigh or calf, slightly raised, no bleeding.",
  "@N@'s @P@: a broad purple bruise with distinct parallel red borders; the muscle is visibly swollen.",
  "@N@'s @P@: a deep, jagged laceration into the muscle; dark blood runs down the shin into @his@ boot; the leg is badly swollen.",
  "@N@'s @P@: crusted maroon-black scabs over the wounds; yellow-green-brown bruising has drained down toward the ankle and foot.",
  "@N@'s @P@: a smooth pinkish-purple scar with darker rings around it; the swelling is gone.",
  "@N@'s @P@: a faint pale scar line runs across the thigh or calf."
] %}

### Whip Wounds
{% for part in whip.parts %}
- {{ replace(replace(replace(replace(at(whip_looks, part.text), "@N@", whip_name), "@P@", part.part), "@him@", whip_him), "@his@", whip_his) }}
{% endfor %}
{% endif %}
{% endif %}

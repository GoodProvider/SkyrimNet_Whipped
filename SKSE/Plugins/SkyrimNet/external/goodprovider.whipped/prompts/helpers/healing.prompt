{# Whip healing narration. SkyrimNet_Whipped_Main.RenderHealPrompt loads this file with RenderTemplate (the raw block comes out #}
{# unrendered), then renders that text with ParseString("heal", json): RenderTemplate binds its variable as a string, not JSON. #}
{# heal.kind: 0 start, 1 pain gone, 2 fully healed, 3 stopped, 4 stages (heal.parts = [{part, stage}]).                       #}
{#   stage: 1 closed (severe -> medium), 0 faded (medium -> light), 3 scabbed (light -> recovering), 4 scarred, 5 healed.      #}
{# heal.source: 0 none (regen / game time), 1 spell, 2 staff, 3 potion, 4 other magic. heal.name, heal.female (0/1),          #}
{# heal.caster ("" if none), heal.caster_is_target (0/1), heal.percent.                                                      #}
{# kind / source are numbers: Papyrus re-cases string literals. inja has no lower() or string +, and parses [..] literals as  #}
{# JSON, so join([var, ...]) fails: build phrases with inline if blocks instead.                                            #}
{# Narration never carries numbers: percent is only turned into words.                                                       #}
{% raw %}
{%- if heal.female -%}{%- set him = "her" -%}{%- set his = "her" -%}{%- set reflexive = "herself" -%}{%- else -%}{%- set him = "him" -%}{%- set his = "his" -%}{%- set reflexive = "himself" -%}{%- endif -%}
{%- set noun = "magic" -%}{%- if heal.source == 1 -%}{%- set noun = "spell" -%}{%- else if heal.source == 2 -%}{%- set noun = "staff" -%}{%- else if heal.source == 3 -%}{%- set noun = "potion" -%}{%- endif -%}
{%- set named_caster = false -%}{%- if heal.caster != "" and (heal.source == 1 or heal.source == 2) -%}{%- set named_caster = true -%}{%- endif -%}
{%- set pron = false -%}{%- set who = heal.name -%}{%- set obj = heal.name -%}
{%- if named_caster and heal.caster_is_target -%}{%- set pron = true -%}{%- set who = reflexive -%}{%- set obj = him -%}{%- endif -%}
{%- set caster_casts = false -%}{%- if heal.source == 1 and heal.caster != "" -%}{%- set caster_casts = true -%}{%- endif -%}
{%- if heal.percent < 34 -%}{%- set progress = "just beginning to heal" -%}{%- else if heal.percent < 67 -%}{%- set progress = "about half way healed" -%}{%- else -%}{%- set progress = "mostly healed" -%}{%- endif -%}
{%- if heal.kind == 4 -%}
{%- for p in heal.parts -%}
{%- if p.stage == 1 -%}The open lacerations on {{ heal.name }}'s {{ p.part }} have closed into deep, bruised welts.
{%- else if p.stage == 0 -%}The welts on {{ heal.name }}'s {{ p.part }} have faded to sore red marks.
{%- else if p.stage == 3 -%}The wounds on {{ heal.name }}'s {{ p.part }} have scabbed over.
{%- else if p.stage == 4 -%}The scabs on {{ heal.name }}'s {{ p.part }} have fallen away, leaving pink scar tissue.
{%- else if p.stage == 5 -%}The pink scar tissue on {{ heal.name }}'s {{ p.part }} has faded to a faint, pale scar line; that wound has fully healed.
{%- endif -%}
{%- if not loop.is_last %} {% endif -%}
{%- endfor -%}
{%- else if heal.kind == 0 -%}
{%- if caster_casts -%}{{ heal.caster }} casts a warm yellow swirling light around {{ who }}, beginning to heal {% if pron %}{{ his }}{% else %}{{ heal.name }}'s{% endif %} welts, wounds, and pain.
{%- else -%}{% if named_caster %}{{ heal.caster }}'s{% else %}The{% endif %} {{ noun }} surrounds {{ obj }} in a warm yellow swirling light, beginning to heal {% if pron %}{{ his }}{% else %}{{ heal.name }}'s{% endif %} welts, wounds, and pain.{%- endif -%}
{%- else if heal.kind == 1 -%}
{%- if heal.source == 0 -%}The pain from {{ heal.name }}'s welts is gone, but the healing continues.
{%- else -%}The warm light of {% if named_caster %}{{ heal.caster }}'s{% else %}the{% endif %} {{ noun }} has taken the pain from {% if pron %}{{ his }}{% else %}{{ heal.name }}'s{% endif %} welts, but the healing continues.{%- endif -%}
{%- else if heal.kind == 2 -%}
{%- if heal.source == 0 -%}{{ heal.name }}'s whip wounds are now fully healed, leaving {{ him }} without pain or blemish.
{%- else if caster_casts -%}{{ heal.caster }} casts a warm yellow swirling light around {{ who }}. {{ heal.name }}'s whip wounds are now fully healed, leaving {{ him }} without pain or blemish.
{%- else -%}{% if named_caster %}{{ heal.caster }}'s{% else %}The{% endif %} {{ noun }} surrounds {{ obj }} in a warm yellow swirling light. {{ heal.name }}'s whip wounds are now fully healed, leaving {{ him }} without pain or blemish.{%- endif -%}
{%- else -%}
The warm light of {% if named_caster %}{{ heal.caster }}'s{% else %}the{% endif %} {{ noun }} fades before the healing is done; {% if pron %}{{ his }}{% else %}{{ heal.name }}'s{% endif %} wounds are {{ progress }}.
{%- endif -%}
{% endraw %}
